# solarized-light: Ethan Schoonover's Solarized (ethanschoonover.com/solarized) on base3; needs a truecolor terminal
base          = #657B83 on #FDF6E3
error         = #DC322F
warning       = #B58900
success       = #859900
accent        = #268BD2
jsonKey       = #268BD2
jsonString    = #2AA198
jsonNumber    = #D33682
jsonLiteral   = #6C71C4
match         = #002B36 on #B58900
muted         = #839496
border        = #839496
borderFocused = #268BD2
logo          = gazelle-solarized-light
