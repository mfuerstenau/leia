# dark: the terminal's own colours, as leia had them before themes (ADR 0095, ADR 0096)
base          = none
error         = red
warning       = yellow
success       = green
accent        = cyan
jsonKey       = cyan
jsonString    = green
jsonNumber    = yellow
jsonLiteral   = magenta
match         = black on yellow
muted         = dark-gray
border        = none
borderFocused = none
logo0         = none
logo1         = #1A0D0D
logo2         = #563F38
logo3         = #9E6038
logo4         = #C7905D
logo5         = #E4CDA5
