{
  "jsonrpc": "2.0",
  "id": 20,
  "method": "startSearch",
  "params": {
    "query": {
      "classic": {
        "expression": "title:lamp AND body:qu*",
        "defaultField": "body",
        "defaultOperator": "OR",
        "options": {
          "allowLeadingWildcard": false,
          "phraseSlop": 0,
          "fuzzyPrefixLength": 0,
          "enablePositionIncrements": true
        },
        "fuzzyMaxEdits": 2,
        "splitOnWhitespace": false,
        "autoGeneratePhraseQueries": false
      }
    },
    "similarity": {"bm25": {"k1": 1.2, "b": 0.75}},
    "sort": [],
    "offset": 0,
    "limit": 2,
    "exactTotalHits": true,
    "fields": ["id", "title"]
  }
}
