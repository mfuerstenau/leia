{
  "tools": [
    {
      "name": "open_index",
      "description": "Open a Lucene index, read-only, in place of the open one, and describe it as index_info does. If it can't be opened, the index that was open stays open.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The index directory, or a directory with indexes below it, which open as one. A leading ~ is the user's home; a relative path is against leia's working directory"
          },
          "directory": {
            "type": "string",
            "enum": [
              "FS",
              "MMAP",
              "NIO"
            ],
            "description": "The Lucene Directory to read it through: FS lets Lucene choose, MMAP is MMapDirectory, NIO is NIOFSDirectory. Defaults to leia's --directory"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The absolute path that was opened"
          },
          "luceneRuntime": {
            "type": "string",
            "description": "The version of the Lucene that reads the index, such as 10.5.2"
          },
          "server": {
            "type": "string",
            "description": "The Elasticsearch or OpenSearch installation whose Lucene reads the index, if one does"
          },
          "numDocs": {
            "type": "integer",
            "description": "Live documents"
          },
          "maxDoc": {
            "type": "integer",
            "description": "Documents including deleted ones; document ids go from 0 to maxDoc - 1"
          },
          "segmentCount": {
            "type": "integer",
            "description": "Segments in all opened commits"
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            },
            "description": "Index directories below the path that were left out, and why"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INDEX_STATS",
                "TOP_TERMS",
                "DOCUMENTS",
                "STORED_VALUES",
                "TERM_VECTORS",
                "POSITIONS",
                "RECONSTRUCT",
                "FILTER",
                "TERMS",
                "POSTINGS",
                "POINTS",
                "DOC_VALUES",
                "KNN_VECTORS",
                "KNN_GRAPH",
                "COMMITS",
                "CLASSIC_SEARCH",
                "TERM_SEARCH",
                "SCORING",
                "DOC_VALUES_SEARCH",
                "STANDARD_SEARCH",
                "MORE_LIKE_THIS",
                "EXPLAIN",
                "HIGHLIGHT",
                "STORED_SCAN",
                "CHECK_INDEX",
                "CHECK_LEVELS",
                "CHECK_THREADS",
                "EXPORT_TERMS",
                "REOPEN",
                "AUTO_STOP_WORDS"
              ]
            },
            "description": "What the runtime that reads the index can do; other tools fail with NOT_SUPPORTED"
          },
          "fieldCount": {
            "type": "integer",
            "description": "How many fields the index has"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "indexOptions": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "DOCS",
                    "DOCS_AND_FREQS",
                    "DOCS_AND_FREQS_AND_POSITIONS",
                    "DOCS_AND_FREQS_AND_POSITIONS_AND_OFFSETS",
                    "DOCS_AND_CUSTOM_FREQS"
                  ],
                  "description": "What the postings hold; NONE if the field isn't indexed"
                },
                "docValuesType": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "NUMERIC",
                    "BINARY",
                    "SORTED",
                    "SORTED_NUMERIC",
                    "SORTED_SET"
                  ]
                },
                "pointDimensionCount": {
                  "type": "integer",
                  "description": "Dimensions of the point values; 0 without points"
                },
                "vectorDimension": {
                  "type": "integer",
                  "description": "Dimensions of the KNN vectors; 0 without vectors"
                },
                "hasTermVectors": {
                  "type": "boolean"
                },
                "docCount": {
                  "type": "integer",
                  "description": "Documents with at least one term in the field, deleted ones included; absent without postings"
                }
              },
              "required": [
                "name",
                "indexOptions",
                "docValuesType",
                "pointDimensionCount",
                "vectorDimension",
                "hasTermVectors"
              ],
              "additionalProperties": false
            },
            "description": "The fields, at most 1000, by field number. The index doesn't record which fields are stored: get_document shows a document's stored values"
          }
        },
        "required": [
          "path",
          "luceneRuntime",
          "numDocs",
          "maxDoc",
          "segmentCount",
          "skipped",
          "features",
          "fieldCount",
          "fields"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "index_info",
      "description": "Describe the open index: its path, the Lucene that reads it, its document counts and its fields with how each is indexed. Fails with NO_INDEX_OPEN if no index is open; open_index opens one.",
      "inputSchema": {
        "type": "object",
        "properties": { },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The absolute path that was opened"
          },
          "luceneRuntime": {
            "type": "string",
            "description": "The version of the Lucene that reads the index, such as 10.5.2"
          },
          "server": {
            "type": "string",
            "description": "The Elasticsearch or OpenSearch installation whose Lucene reads the index, if one does"
          },
          "numDocs": {
            "type": "integer",
            "description": "Live documents"
          },
          "maxDoc": {
            "type": "integer",
            "description": "Documents including deleted ones; document ids go from 0 to maxDoc - 1"
          },
          "segmentCount": {
            "type": "integer",
            "description": "Segments in all opened commits"
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            },
            "description": "Index directories below the path that were left out, and why"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INDEX_STATS",
                "TOP_TERMS",
                "DOCUMENTS",
                "STORED_VALUES",
                "TERM_VECTORS",
                "POSITIONS",
                "RECONSTRUCT",
                "FILTER",
                "TERMS",
                "POSTINGS",
                "POINTS",
                "DOC_VALUES",
                "KNN_VECTORS",
                "KNN_GRAPH",
                "COMMITS",
                "CLASSIC_SEARCH",
                "TERM_SEARCH",
                "SCORING",
                "DOC_VALUES_SEARCH",
                "STANDARD_SEARCH",
                "MORE_LIKE_THIS",
                "EXPLAIN",
                "HIGHLIGHT",
                "STORED_SCAN",
                "CHECK_INDEX",
                "CHECK_LEVELS",
                "CHECK_THREADS",
                "EXPORT_TERMS",
                "REOPEN",
                "AUTO_STOP_WORDS"
              ]
            },
            "description": "What the runtime that reads the index can do; other tools fail with NOT_SUPPORTED"
          },
          "fieldCount": {
            "type": "integer",
            "description": "How many fields the index has"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "indexOptions": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "DOCS",
                    "DOCS_AND_FREQS",
                    "DOCS_AND_FREQS_AND_POSITIONS",
                    "DOCS_AND_FREQS_AND_POSITIONS_AND_OFFSETS",
                    "DOCS_AND_CUSTOM_FREQS"
                  ],
                  "description": "What the postings hold; NONE if the field isn't indexed"
                },
                "docValuesType": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "NUMERIC",
                    "BINARY",
                    "SORTED",
                    "SORTED_NUMERIC",
                    "SORTED_SET"
                  ]
                },
                "pointDimensionCount": {
                  "type": "integer",
                  "description": "Dimensions of the point values; 0 without points"
                },
                "vectorDimension": {
                  "type": "integer",
                  "description": "Dimensions of the KNN vectors; 0 without vectors"
                },
                "hasTermVectors": {
                  "type": "boolean"
                },
                "docCount": {
                  "type": "integer",
                  "description": "Documents with at least one term in the field, deleted ones included; absent without postings"
                }
              },
              "required": [
                "name",
                "indexOptions",
                "docValuesType",
                "pointDimensionCount",
                "vectorDimension",
                "hasTermVectors"
              ],
              "additionalProperties": false
            },
            "description": "The fields, at most 1000, by field number. The index doesn't record which fields are stored: get_document shows a document's stored values"
          }
        },
        "required": [
          "path",
          "luceneRuntime",
          "numDocs",
          "maxDoc",
          "segmentCount",
          "skipped",
          "features",
          "fieldCount",
          "fields"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search",
      "description": "Search the open index, best score first, a page at a time: each hit with its document id, score and stored values brief. Give a query in Lucene's classic syntax with a defaultField, or a term for an exact keyword. For the next page, call it again with the result's nextOffset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A query in Lucene's classic syntax, such as title:lamp AND body:qu*, analyzed with StandardAnalyzer. Give exactly one of query and term"
          },
          "term": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "description": "The term as text, or in hex with binary"
              },
              "binary": {
                "type": "boolean",
                "description": "Whether value is the term's bytes in hex; false by default"
              }
            },
            "required": [
              "field",
              "value"
            ],
            "additionalProperties": false,
            "description": "A query for exactly one term, neither analyzed nor split: for keyword fields such as ids. Give exactly one of query and term"
          },
          "defaultField": {
            "type": "string",
            "description": "The field of the query's terms that name none; needed with query"
          },
          "defaultOperator": {
            "type": "string",
            "enum": [
              "OR",
              "AND"
            ],
            "description": "How clauses of the query without an operator combine; OR by default"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The stored fields to show per hit; all of them by default, [] for none"
          },
          "offset": {
            "type": "integer",
            "description": "How many hits to skip, for the next page: the nextOffset of the last page; 0 by default"
          },
          "limit": {
            "type": "integer",
            "description": "The most hits of the page, from 1 to 100; 10 by default"
          },
          "exactTotalHits": {
            "type": "boolean",
            "description": "Whether to count every hit; otherwise counting stops after 1000; false by default"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The query as Lucene writes it"
          },
          "rewrittenQuery": {
            "type": "string",
            "description": "The query after rewriting"
          },
          "totalHits": {
            "type": "integer"
          },
          "totalHitsRelation": {
            "type": "string",
            "enum": [
              "EQUAL_TO",
              "GREATER_THAN_OR_EQUAL_TO"
            ],
            "description": "Whether totalHits is exact (EQUAL_TO) or a lower bound"
          },
          "offset": {
            "type": "integer"
          },
          "nextOffset": {
            "type": "integer",
            "description": "The offset of the next page; absent on the last page"
          },
          "tookMillis": {
            "type": "integer"
          },
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "docId": {
                  "type": "integer",
                  "description": "The document id, for get_document"
                },
                "score": {
                  "type": "number"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "STRING",
                                "BINARY",
                                "INT",
                                "LONG",
                                "FLOAT",
                                "DOUBLE"
                              ]
                            },
                            "value": {
                              "type": "string",
                              "description": "The value; numbers in decimal; binary values as text if they are UTF-8, else in hex"
                            },
                            "binary": {
                              "type": "boolean",
                              "description": "Whether value is in hex"
                            },
                            "cut": {
                              "type": "boolean",
                              "description": "Whether value is cut at 256 bytes; get_field_value has it whole"
                            }
                          },
                          "required": [
                            "type",
                            "value",
                            "binary",
                            "cut"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "name",
                      "values"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The hit's stored values, in the order of each field's first value"
                }
              },
              "required": [
                "docId",
                "score",
                "fields"
              ],
              "additionalProperties": false
            },
            "description": "The hits of the page, best score first"
          }
        },
        "required": [
          "query",
          "rewrittenQuery",
          "totalHits",
          "totalHitsRelation",
          "offset",
          "tookMillis",
          "hits"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_document",
      "description": "Show a document of the open index by its id: per field its stored values, doc values, norm, KNN vector and whether it has a term vector. Long values are cut, with their full length; get_field_value reads one whole. Fields that are only indexed show no value: reconstruct_fields rebuilds them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": {
            "type": "integer",
            "description": "The document id, from 0 to maxDoc - 1; a deleted document can be read too"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The fields to show, in the index's order; by default every field the document has something in"
          },
          "maxValueLength": {
            "type": "integer",
            "description": "The longest value shown whole, in characters, up to 65536; 2048 by default. get_field_value has a longer one whole"
          },
          "withVectors": {
            "type": "boolean",
            "description": "Whether to show the components of KNN vectors; otherwise only their dimension; false by default"
          }
        },
        "required": [
          "docId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "docId": {
            "type": "integer"
          },
          "deleted": {
            "type": "boolean",
            "description": "Whether the document is deleted; its data is there until a merge"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "norm": {
                  "type": "integer",
                  "description": "The document's norm; absent without norms"
                },
                "stored": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "STRING",
                          "BINARY",
                          "INT",
                          "LONG",
                          "FLOAT",
                          "DOUBLE"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "description": "The value; numbers in decimal; binary values as text if they are UTF-8, else in hex"
                      },
                      "binary": {
                        "type": "boolean",
                        "description": "Whether value is in hex"
                      },
                      "fullLength": {
                        "type": "integer",
                        "description": "Present if value is cut: the length of the whole value in characters; get_field_value has the rest"
                      }
                    },
                    "required": [
                      "type",
                      "value",
                      "binary"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The stored values, in the order they were added; empty if none are stored"
                },
                "docValues": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "NONE",
                        "NUMERIC",
                        "BINARY",
                        "SORTED",
                        "SORTED_NUMERIC",
                        "SORTED_SET"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "description": "How many values the document has"
                    },
                    "numbers": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "description": "The raw numbers of a NUMERIC or SORTED_NUMERIC field, at most 100"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "description": "The bytes as text if they are UTF-8, else in hex"
                          },
                          "binary": {
                            "type": "boolean"
                          },
                          "fullLength": {
                            "type": "integer",
                            "description": "Present if value is cut: the length of the whole value in characters"
                          }
                        },
                        "required": [
                          "value",
                          "binary"
                        ],
                        "additionalProperties": false
                      },
                      "description": "The values of a BINARY, SORTED or SORTED_SET field, at most 100"
                    }
                  },
                  "required": [
                    "type",
                    "count",
                    "numbers",
                    "values"
                  ],
                  "additionalProperties": false,
                  "description": "The document's doc values; absent if it has none in the field"
                },
                "hasTermVector": {
                  "type": "boolean",
                  "description": "Whether the document has a term vector in the field"
                },
                "vector": {
                  "type": "object",
                  "properties": {
                    "encoding": {
                      "type": "string",
                      "enum": [
                        "BYTE",
                        "FLOAT32"
                      ]
                    },
                    "dimension": {
                      "type": "integer"
                    },
                    "floats": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "description": "The components of a FLOAT32 vector, with withVectors"
                    },
                    "bytes": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "description": "The components of a BYTE vector, signed, with withVectors"
                    }
                  },
                  "required": [
                    "encoding",
                    "dimension"
                  ],
                  "additionalProperties": false,
                  "description": "The document's KNN vector; absent if it has none in the field"
                }
              },
              "required": [
                "name",
                "stored",
                "hasTermVector"
              ],
              "additionalProperties": false
            },
            "description": "The fields, in the index's order"
          }
        },
        "required": [
          "docId",
          "deleted",
          "fields"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_field_value",
      "description": "Read one stored value of a document whole, in slices of characters: for a value that get_document or search cut. Call it again with nextOffset until it is absent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": {
            "type": "integer"
          },
          "field": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "description": "Which of the document's stored values in the field, from 0, as get_document lists them; 0 by default"
          },
          "offset": {
            "type": "integer",
            "description": "Where the slice starts, in characters: the nextOffset of the last slice; 0 by default"
          },
          "length": {
            "type": "integer",
            "description": "The most characters of the slice, up to 65536; 16384 by default"
          }
        },
        "required": [
          "docId",
          "field"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "STRING",
              "BINARY",
              "INT",
              "LONG",
              "FLOAT",
              "DOUBLE"
            ]
          },
          "binary": {
            "type": "boolean",
            "description": "Whether value is in hex: a binary value that isn't UTF-8"
          },
          "value": {
            "type": "string",
            "description": "The slice of the value"
          },
          "offset": {
            "type": "integer"
          },
          "totalLength": {
            "type": "integer",
            "description": "The length of the whole value in characters"
          },
          "nextOffset": {
            "type": "integer",
            "description": "Where the next slice starts; absent at the end of the value"
          }
        },
        "required": [
          "field",
          "index",
          "type",
          "binary",
          "value",
          "offset",
          "totalLength"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "reconstruct_fields",
      "description": "Rebuild the terms and points a document was indexed with, field by field, from its term vectors or the postings: what an indexed field holds even if it isn't stored. With positions, text gives the terms in order. It goes through every term of a field without a term vector, which can take a while in a large index.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "docId": {
            "type": "integer",
            "description": "The document id, from 0 to maxDoc - 1; a deleted document is rebuilt too"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The fields with postings or points to rebuild, in this order; by default every such field"
          },
          "maxTerms": {
            "type": "integer",
            "description": "The most terms per field, up to 10000; 500 by default"
          }
        },
        "required": [
          "docId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "indexOptions": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "DOCS",
                    "DOCS_AND_FREQS",
                    "DOCS_AND_FREQS_AND_POSITIONS",
                    "DOCS_AND_FREQS_AND_POSITIONS_AND_OFFSETS",
                    "DOCS_AND_CUSTOM_FREQS"
                  ],
                  "description": "What the postings of the field hold in the document's segment"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "TERM_VECTOR",
                    "POSTINGS"
                  ],
